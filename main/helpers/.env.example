# Shared configuration for all Quickshell helper commands.
# Copy to .env; existing environment variables take precedence.
# This file is read as dotenv data, never executed as a shell script.

# FRITZ!Box: use a dedicated user.
# Create/read the user in the FRITZ!Box web UI:
# System > FRITZ!Box Users > Users
# The user needs permission to access FRITZ!Box settings.
FRITZBOX_USER=quickshell
FRITZBOX_PASSWORD=change-me

# Optional tuning. Values are ratios of your configured line rate.
# FRITZ_TRAFFIC_DOWN_LIMIT_MBIT=250
# FRITZ_TRAFFIC_UP_LIMIT_MBIT=50
# FRITZ_TRAFFIC_WARN_AT=0.75
# FRITZ_TRAFFIC_HIDE_AT=0.65
# FRITZ_TRAFFIC_CRITICAL_AT=0.90
# FRITZBOX_URL=http://fritz.box:49000
# FRITZ_TRAFFIC_TIMEOUT=4

# Package updates.
# QUICKSHELL_UPDATES_TIMEOUT=120
# QUICKSHELL_UPDATES_MAX_ITEMS=160

# Kubernetes alerts. Leave the namespace unset for automatic discovery.
# ALERTMANAGER_NAMESPACE=monitoring
# K8S_ALERTS_TIMEOUT=8s
